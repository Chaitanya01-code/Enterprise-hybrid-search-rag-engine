# PostgreSQL connection string (Neon, Supabase, local, etc.)
# Formats accepted:
#   postgresql://user:password@host/dbname
#   postgresql+pg8000://user:password@host/dbname
#   postgres://user:password@host/dbname   (auto-converted to pg8000)
# Leave empty to fall back to a local SQLite file (enterprise_rag.db).
DATABASE_URL=postgresql://user:password@your-host/dbname

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API=your-gemini-api-key-here

# Directory where uploaded files are persisted inside the container.
# Must match the volume mount path in docker-compose.yml.
UPLOAD_DIR=/app/uploads
